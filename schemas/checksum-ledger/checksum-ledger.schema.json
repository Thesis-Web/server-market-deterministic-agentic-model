{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChecksumLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "checksum_ledger_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "checksum-ledger"
    },
    "checksum_ledger_id": {
      "type": "string",
      "pattern": "^checksum-ledger-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checksum_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": ["not_reviewed", "in_review", "approved", "approved_with_notes", "rejected"]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "checksum_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_path",
        "artifact_type",
        "checksum_algorithm",
        "checksum_value",
        "generated_at",
        "generated_by",
        "notes"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_path": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string"
        },
        "checksum_algorithm": {
          "type": "string",
          "enum": ["sha256"]
        },
        "checksum_value": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
