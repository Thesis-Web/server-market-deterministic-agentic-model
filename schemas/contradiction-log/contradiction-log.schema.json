{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContradictionLog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contradiction_log_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "contradiction-log"
    },
    "contradiction_log_id": {
      "type": "string",
      "pattern": "^contradiction-log-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "in_review",
        "approved",
        "approved_with_notes",
        "rejected"
      ]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "contradiction_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id",
        "related_evidence_ids",
        "conflicting_claims",
        "contradiction_type",
        "severity",
        "disposition",
        "impacted_artifacts",
        "notes"
      ],
      "properties": {
        "contradiction_id": {
          "type": "string"
        },
        "related_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "conflicting_claims": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "contradiction_type": {
          "type": "string",
          "enum": [
            "source_conflict",
            "interpretation_conflict",
            "timing_conflict",
            "model_inference_conflict",
            "evidence_gap"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "unresolved",
            "source_conflict",
            "weak_signal_not_confirmed",
            "evidence_gap",
            "resolved_in_favor_of_primary_source",
            "resolved_in_favor_of_cross_validated_source",
            "compiler_overreach_corrected"
          ]
        },
        "impacted_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "overlap_result": {
          "type": "string",
          "enum": [
            "confirmed",
            "contradicted",
            "broadened",
            "unresolved"
          ]
        }
      }
    }
  }
}