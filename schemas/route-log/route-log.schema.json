{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteLog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "route_log_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "route-log"
    },
    "route_log_id": {
      "type": "string",
      "pattern": "^route-log-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_log_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": ["not_reviewed", "in_review", "approved", "approved_with_notes", "rejected"]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "route_log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_log_entry_id",
        "timestamp",
        "run_id",
        "task_class",
        "selected_model",
        "selected_environment",
        "selected_role",
        "alternate_models_considered",
        "overlap_required",
        "route_action",
        "route_reason",
        "operator_note"
      ],
      "properties": {
        "route_log_entry_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
        },
        "task_class": {
          "type": "string"
        },
        "selected_model": {
          "type": "string"
        },
        "selected_environment": {
          "type": "string"
        },
        "selected_role": {
          "type": "string"
        },
        "alternate_models_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlap_required": {
          "type": "boolean"
        },
        "route_action": {
          "type": "string",
          "enum": [
            "route_assigned",
            "route_confirmed",
            "overlap_added",
            "overlap_removed",
            "rerouted",
            "route_blocked",
            "route_completed"
          ]
        },
        "route_reason": {
          "type": "string"
        },
        "operator_note": {
          "type": "string"
        },
        "overlap_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
