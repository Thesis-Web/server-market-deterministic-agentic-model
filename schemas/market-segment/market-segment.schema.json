{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketSegmentDefinition",
  "type": "object",
  "required": [
    "primary_model_origin",
    "supporting_model_origins",
    "model_stage_contributions",
    "schema_version",
    "artifact_type",
    "status",
    "segment_id",
    "segment_name"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "market-segment-definition"
    },
    "segment_id": {
      "type": "string"
    },
    "segment_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    },
    "primary_model_origin": {
      "type": "string",
      "minLength": 1
    },
    "supporting_model_origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_stage_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "model_origin"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "acquisition",
              "normalization",
              "synthesis",
              "contradiction-review",
              "compilation"
            ]
          },
          "model_origin": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
