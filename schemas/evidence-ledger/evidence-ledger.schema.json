{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "ledger_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "evidence-ledger"
    },
    "ledger_id": {
      "type": "string",
      "pattern": "^evidence-ledger-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": ["not_reviewed", "in_review", "approved", "approved_with_notes", "rejected"]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_title",
        "source_type",
        "source_tier",
        "observed_date",
        "source_locator",
        "retrieved_at",
        "retrieved_by_model",
        "retrieved_in_environment",
        "used_in_artifacts",
        "claim_class",
        "notes"
      ],
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "source_title": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "source_tier": {
          "type": "string",
          "enum": ["tier1", "tier2", "tier3", "tier4", "tier5"]
        },
        "observed_date": {
          "type": "string",
          "format": "date"
        },
        "source_locator": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_by_model": {
          "type": "string"
        },
        "retrieved_in_environment": {
          "type": "string"
        },
        "used_in_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_class": {
          "type": "string",
          "enum": [
            "observed_fact",
            "cross_validated_fact",
            "derived_implication",
            "scenario_hypothesis"
          ]
        },
        "fact_status": {
          "type": "string",
          "enum": ["captured", "validated", "contradicted", "superseded", "unresolved"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
