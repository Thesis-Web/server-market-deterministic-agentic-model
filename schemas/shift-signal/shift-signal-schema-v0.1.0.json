{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shift Signal Schema v0.1.0",
  "type": "object",
  "required": ["signal_set_id", "scope", "signals", "evidence_refs", "unresolved_items"],
  "properties": {
    "signal_set_id": { "type": "string" },
    "scope": { "type": "object" },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "category",
          "description",
          "directionality",
          "confidence",
          "time_horizon",
          "potential_impacts",
          "evidence_refs"
        ],
        "properties": {
          "label": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "market",
              "regulatory",
              "supply-chain",
              "silicon",
              "power",
              "cooling",
              "software",
              "competitive"
            ]
          },
          "description": { "type": "string" },
          "directionality": { "type": "string", "enum": ["tailwind", "headwind", "ambiguous"] },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "time_horizon": { "type": "string", "enum": ["near", "mid", "long"] },
          "potential_impacts": { "type": "array", "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "unresolved_items": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
