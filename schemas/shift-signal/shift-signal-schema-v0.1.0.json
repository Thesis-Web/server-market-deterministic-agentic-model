{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShiftSignalNote",
  "type": "object",
  "required": [
    "primary_model_origin",
    "supporting_model_origins",
    "model_stage_contributions",
    "schema_version",
    "artifact_type",
    "status",
    "signal_set_id",
    "scope",
    "signals",
    "evidence_refs",
    "unresolved_items"
  ],
  "properties": {
    "signal_set_id": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "category",
          "description",
          "directionality",
          "confidence",
          "time_horizon",
          "potential_impacts",
          "evidence_refs"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "market",
              "regulatory",
              "supply-chain",
              "silicon",
              "power",
              "cooling",
              "software",
              "competitive"
            ]
          },
          "description": {
            "type": "string"
          },
          "directionality": {
            "type": "string",
            "enum": ["tailwind", "headwind", "ambiguous"]
          },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "time_horizon": {
            "type": "string",
            "enum": ["near", "mid", "long"]
          },
          "potential_impacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "shift-signal-note"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    },
    "primary_model_origin": {
      "type": "string",
      "minLength": 1
    },
    "supporting_model_origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_stage_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "model_origin"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "acquisition",
              "normalization",
              "synthesis",
              "contradiction-review",
              "compilation"
            ]
          },
          "model_origin": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
