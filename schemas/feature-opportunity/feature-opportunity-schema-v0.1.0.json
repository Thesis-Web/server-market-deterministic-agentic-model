{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureOpportunity",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "opportunity_set_id",
    "scope",
    "opportunities",
    "evidence_refs",
    "unresolved_items"
  ],
  "properties": {
    "opportunity_set_id": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "featureLabel",
          "description",
          "mapped_pain_points",
          "expected_value",
          "feasibility",
          "time_horizon",
          "design_traits",
          "risks",
          "evidence_refs"
        ],
        "properties": {
          "featureLabel": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mapped_pain_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_value": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "feasibility": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "time_horizon": {
            "type": "string",
            "enum": ["near", "mid", "long"]
          },
          "design_traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "feature-opportunity"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    }
  },
  "additionalProperties": false
}
