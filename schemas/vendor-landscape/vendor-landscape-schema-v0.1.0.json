{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VendorLandscape",
  "type": "object",
  "required": [
    "primary_model_origin",
    "supporting_model_origins",
    "model_stage_contributions",
    "schema_version",
    "artifact_type",
    "status",
    "landscape_id",
    "scope",
    "vendors",
    "evidence_refs",
    "unresolved_items"
  ],
  "properties": {
    "landscape_id": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vendor_name",
          "vendor_type",
          "offerings_summary",
          "positioning_summary",
          "differentiators",
          "weaknesses",
          "risk_flags",
          "evidence_refs"
        ],
        "properties": {
          "vendor_name": {
            "type": "string"
          },
          "vendor_type": {
            "type": "string",
            "enum": ["oem", "odm", "cloud", "integrator", "component", "reseller"]
          },
          "offerings_summary": {
            "type": "string"
          },
          "positioning_summary": {
            "type": "string"
          },
          "differentiators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weaknesses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "vendor-landscape"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    },
    "primary_model_origin": {
      "type": "string",
      "minLength": 1
    },
    "supporting_model_origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_stage_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "model_origin"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "acquisition",
              "normalization",
              "synthesis",
              "contradiction-review",
              "compilation"
            ]
          },
          "model_origin": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
