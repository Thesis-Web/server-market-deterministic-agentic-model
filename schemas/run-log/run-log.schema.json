{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunLog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "run_log_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "run-log"
    },
    "run_log_id": {
      "type": "string",
      "pattern": "^run-log-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{2}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run_log_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": ["not_reviewed", "in_review", "approved", "approved_with_notes", "rejected"]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "run_log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_log_entry_id",
        "event_timestamp",
        "lifecycle_stage",
        "event_type",
        "event_status",
        "actor",
        "related_gate",
        "message",
        "notes"
      ],
      "properties": {
        "run_log_entry_id": {
          "type": "string"
        },
        "event_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "lifecycle_stage": {
          "type": "string",
          "enum": [
            "initialized",
            "acquisition",
            "normalization",
            "synthesis",
            "validation",
            "compilation",
            "review",
            "publication",
            "recovery",
            "closed"
          ]
        },
        "event_type": {
          "type": "string",
          "enum": [
            "run_started",
            "stage_entered",
            "stage_completed",
            "gate_evaluated",
            "restart_point_recorded",
            "run_paused",
            "run_resumed",
            "run_completed",
            "run_failed",
            "operator_note"
          ]
        },
        "event_status": {
          "type": "string",
          "enum": ["info", "passed", "failed", "blocked", "resumed", "completed"]
        },
        "actor": {
          "type": "string"
        },
        "related_gate": {
          "type": "string",
          "enum": [
            "input-gate",
            "evidence-gate",
            "schema-gate",
            "reasoning-gate",
            "output-gate",
            "publish-gate",
            "none"
          ]
        },
        "message": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
