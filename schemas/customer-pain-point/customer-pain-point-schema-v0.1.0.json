{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Pain-Point Schema v0.1.0",
  "type": "object",
  "required": ["painPointSetId", "scope", "painPoints", "evidenceRefs", "unresolvedItems"],
  "properties": {
    "painPointSetId": { "type": "string" },
    "scope": { "type": "object" },
    "painPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "description",
          "severity",
          "frequency",
          "buyingDrivers",
          "impactedLifecyclePhase",
          "designImplications",
          "evidenceRefs"
        ],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "frequency": { "type": "string", "enum": ["rare", "occasional", "common", "ubiquitous"] },
          "buyingDrivers": { "type": "array", "items": { "type": "string" } },
          "impactedLifecyclePhase": {
            "type": "string",
            "enum": ["procure", "deploy", "operate", "maintain", "refresh"]
          },
          "designImplications": { "type": "array", "items": { "type": "string" } },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "unresolvedItems": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
