{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CustomerPainPoint",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "pain_point_set_id",
    "scope",
    "pain_points",
    "evidence_refs",
    "unresolved_items"
  ],
  "properties": {
    "pain_point_set_id": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "pain_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "description",
          "severity",
          "frequency",
          "buying_drivers",
          "impacted_lifecycle_phase",
          "design_implications",
          "evidence_refs"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "frequency": {
            "type": "string",
            "enum": ["rare", "occasional", "common", "ubiquitous"]
          },
          "buying_drivers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impacted_lifecycle_phase": {
            "type": "string",
            "enum": ["procure", "deploy", "operate", "maintain", "refresh"]
          },
          "design_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "customer-pain-point"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    }
  },
  "additionalProperties": false
}
