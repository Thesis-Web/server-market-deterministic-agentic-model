{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Region Profile Schema v0.1.0",
  "type": "object",
  "required": [
    "region_id",
    "region_name",
    "region_type",
    "effective_date",
    "evidence_refs",
    "constraints",
    "deployment_realities",
    "compliance_and_certifications",
    "unresolved_items"
  ],
  "properties": {
    "region_id": { "type": "string" },
    "region_name": { "type": "string" },
    "region_type": {
      "type": "string",
      "enum": ["country", "bloc", "subregion", "state-province", "metro"]
    },
    "effective_date": { "type": "string" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "object" },
    "deployment_realities": { "type": "object" },
    "compliance_and_certifications": { "type": "array", "items": { "type": "string" } },
    "unresolved_items": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
