{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegionProfile",
  "type": "object",
  "required": [
    "primary_model_origin",
    "supporting_model_origins",
    "model_stage_contributions",
    "schema_version",
    "artifact_type",
    "status",
    "region_id",
    "region_name",
    "region_type",
    "effective_date",
    "evidence_refs",
    "constraints",
    "deployment_realities",
    "compliance_and_certifications",
    "unresolved_items"
  ],
  "properties": {
    "region_id": {
      "type": "string"
    },
    "region_name": {
      "type": "string"
    },
    "region_type": {
      "type": "string",
      "enum": ["country", "bloc", "subregion", "state-province", "metro"]
    },
    "effective_date": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object"
    },
    "deployment_realities": {
      "type": "object"
    },
    "compliance_and_certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "region-profile"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in-review", "validated", "blocked", "invalidated", "published"]
    },
    "primary_model_origin": {
      "type": "string",
      "minLength": 1
    },
    "supporting_model_origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "model_stage_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "model_origin"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "acquisition",
              "normalization",
              "synthesis",
              "contradiction-review",
              "compilation"
            ]
          },
          "model_origin": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
