{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewLog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "review_log_id",
    "run_id",
    "project",
    "entries",
    "review_state",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "review-log"
    },
    "review_log_id": {
      "type": "string",
      "pattern": "^review-log-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]{8}-[a-z0-9-]+-[0-9]{4}$"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_entry"
      }
    },
    "notes": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": ["not_reviewed", "in_review", "approved", "approved_with_notes", "rejected"]
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "review_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_entry_id",
        "reviewed_object_id",
        "reviewed_object_type",
        "gate_name",
        "reviewer",
        "review_timestamp",
        "decision",
        "decision_reason",
        "follow_up_actions",
        "notes"
      ],
      "properties": {
        "review_entry_id": {
          "type": "string"
        },
        "reviewed_object_id": {
          "type": "string"
        },
        "reviewed_object_type": {
          "type": "string",
          "enum": ["run", "artifact", "schema", "template", "prompt-pack", "output"]
        },
        "gate_name": {
          "type": "string",
          "enum": [
            "input-gate",
            "evidence-gate",
            "schema-gate",
            "reasoning-gate",
            "output-gate",
            "publish-gate",
            "manual-review"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "review_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "type": "string",
          "enum": ["approved", "approved_with_notes", "rejected", "needs_revision", "deferred"]
        },
        "decision_reason": {
          "type": "string"
        },
        "follow_up_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
